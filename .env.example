# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Só variáveis NEXT_PUBLIC_ vão para o navegador: use apenas para valores realmente públicos.

# Público
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Entram nas próximas fases (deixe vazio até lá):
# NEXT_PUBLIC_SUPABASE_URL=            # F4
# NEXT_PUBLIC_SUPABASE_ANON_KEY=       # F4 (chave anon: protegida por RLS)
# SUPABASE_SERVICE_ROLE_KEY=           # F4 — só servidor, nunca no cliente
# UPSTASH_REDIS_REST_URL=              # F5 — rate limit
# UPSTASH_REDIS_REST_TOKEN=            # F5 — só servidor
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # F7 — anti-bot
# TURNSTILE_SECRET_KEY=                # F7 — só servidor
# RESEND_API_KEY=                      # F8 — só servidor
# CRON_SECRET=                         # F8 — protege a rota do Vercel Cron
